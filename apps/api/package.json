{
  "name": "@proofbook/api",
  "version": "0.1.0",
  "private": true,
  "description": "Proofbook Core REST API for organizations, records, and approvals",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
