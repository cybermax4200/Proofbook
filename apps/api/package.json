    "drizzle-orm": "^0.38.4",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.0",
    "@types/pg": "^8.11.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
