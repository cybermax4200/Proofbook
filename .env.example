# Network
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
PROOFBOOK_CONTRACT_ID=

# Platform Fee Payer (never commit real secrets)
FEE_PAYER_SECRET=

# Database (defaults to in-process PGlite if unset, or a Postgres URL)
