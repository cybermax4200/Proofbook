# Network
STELLAR_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
PROOFBOOK_CONTRACT_ID=

# Platform Fee Payer & Organization Signer (never commit real secrets)
FEE_PAYER_SECRET=
ORG_SECRET=

# API Server & Worker
PORT=3001
WORKER_PORT=3002
CHECKPOINT_INTERVAL=60s
TTL_EXTEND_INTERVAL=7d
WORKER_API_KEY=

# Database (defaults to in-process PGlite if unset, or a Postgres URL)
DATABASE_URL=

# Encrypted Object Storage (local fallback if unconfigured; S3_* aliases also supported)
OBJECT_STORE_ENDPOINT=
OBJECT_STORE_BUCKET=proofbook-evidence
OBJECT_STORE_ACCESS_KEY=
OBJECT_STORE_SECRET_KEY=

# App Secrets (JWT_SECRET alias also supported)
SESSION_SECRET=dev_session_secret_change_in_production_32chars
