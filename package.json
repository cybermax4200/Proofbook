{
  "name": "proofbook-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Tamper-evident, privacy-preserving evidence trails anchored on Stellar / Soroban",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:vectors": "pnpm --filter @proofbook/crypto test:vectors",
    "lint": "pnpm -r run lint",
    "contract:test": "pnpm --filter @proofbook/contracts test",
    "contract:build": "pnpm --filter @proofbook/contracts build",
    "contract:deploy": "pnpm --filter @proofbook/contracts deploy:testnet",
    "contract:interact": "pnpm --filter @proofbook/contracts interact:testnet"
  },
  "packageManager": "pnpm@10.28.2"
}
